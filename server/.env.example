# Server Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/futon_dev?schema=public

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / Upstash
REDIS_URL=redis://localhost:6379

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email (Resend)
RESEND_API_KEY=re_placeholder
FROM_EMAIL=noreply@futon.dev

# Sentry Monitoring
SENTRY_DSN=
